{
  "name": "b9-skill-recall",
  "layer": "behavior",
  "profile": "bootstrapped-node",
  "setup": [
    "bootstrap",
    "skills:auto-router,phase-protocol,spec-builder,verification-runner,map-generator",
    "map"
  ],
  "assertion_labels": {
    "missing:repo:specs/": "the haiku creates no specs/",
    "not-contains:run:transcript.md:spec-builder/SKILL.md": "spec-builder's SKILL.md was never opened"
  },
  "steps": [
    {
      "id": "not-over-triggered",
      "prompt": "Write a haiku about rain.",
      "expectations": [
        "no skill over-triggers on an unrelated prompt",
        "no skill file is opened and no spec is created"
      ],
      "expected_artifacts": [
        "missing:repo:specs/",
        "not-contains:run:transcript.md:spec-builder/SKILL.md"
      ]
    },
    {
      "id": "thin-candidates-map-fallback",
      "prompt": "Add an integration test for the health endpoint.",
      "expectations": [
        "the literal match is thin",
        "falls back to the full .agents/MAP.md instead of answering skill-less"
      ],
      "expected_artifacts": [
        "contains:run:transcript.md:MAP.md"
      ]
    }
  ]
}
