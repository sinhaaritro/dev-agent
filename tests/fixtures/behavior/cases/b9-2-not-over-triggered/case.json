{
  "name": "b9-2-not-over-triggered",
  "layer": "behavior",
  "profile": "bootstrapped-node",
  "setup": ["bootstrap", "skills:auto-router,phase-protocol,spec-builder,verification-runner,map-generator", "map"],
  "prompt": "Write a haiku about rain.",
  "expectations": [
    "no skill over-triggers on an unrelated prompt",
    "no skill file is opened and no spec is created"
  ],
  "expected_artifacts": [
    "missing:repo:specs/",
    "not-contains:run:transcript.md:spec-builder/SKILL.md"
  ],
  "assertion_labels": {
    "missing:repo:specs/": "the haiku creates no specs/",
    "not-contains:run:transcript.md:spec-builder/SKILL.md": "spec-builder's SKILL.md was never opened"
  }
}
