{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp",
                "--api-key",
                "YOUR_API_KEY"
            ]
        },
        "git": {
            "command": "uvx",
            "args": [
                "mcp-server-git",
                "--repository",
                "."
            ]
        },
        "gitmcp": {
            "command": "npx",
            "args": [
                "-y",
                "mcp-remote",
                "https://gitmcp.io/sse"
            ]
        }
    }
}